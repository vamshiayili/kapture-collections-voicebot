                  "account_id": "ACC-88392",
                  "ptp_date": "2026-08-25",
                  "amount": 8499.00
                }
              }
            }
          ]
        }
      },
      "expected_output": {
        "success": true,
        "account_id": "ACC-88392",
        "amount": 8499,
        "confirmed_date": "2026-08-25"
      }
    },
