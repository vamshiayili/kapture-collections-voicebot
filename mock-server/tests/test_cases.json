{
  "description": "Comprehensive Test Cases for Kapture Collections Voicebot (Maya) Webhook Tools",
  "test_cases": [
    {
      "id": "TC-01",
      "tool": "verify_customer",
      "description": "Valid PIN (1234) for Rahul Sharma (ACC-88392) should return verified=true, name='Rahul Sharma', currency='INR', and balance=8499",
      "payload": {
        "message": {
          "type": "tool-calls",
          "toolCalls": [
            {
              "id": "call_rahul_001",
              "type": "function",
              "function": {
                "name": "verify_customer",
                "arguments": {
                  "account_id": "ACC-88392",
                  "verification_code": "1234"
                }
              }
            }
          ]
        }
      },
      "expected_output": {
        "verified": true,
        "account_id": "ACC-88392",
        "customer_name": "Rahul Sharma",
        "customer_phone": "+91 98765 43210",
        "outstanding_balance": 8499,
        "currency": "INR",
        "due_date": "2026-08-03"
      }
    },
    {
      "id": "TC-02",
      "tool": "verify_customer",
      "description": "Invalid PIN (9999) for Rahul Sharma (ACC-88392) should fail verification and return verified=false",
      "payload": {
        "message": {
          "type": "tool-calls",
          "toolCalls": [
            {
              "id": "call_rahul_002",
              "type": "function",
              "function": {
                "name": "verify_customer",
                "arguments": {
                  "account_id": "ACC-88392",
                  "verification_code": "9999"
                }
              }
            }
          ]
        }
      },
      "expected_output": {
        "verified": false,
        "account_id": "ACC-88392"
      }
    },
    {
      "id": "TC-03",
      "tool": "verify_customer",
      "description": "Valid PIN (1234) for default account (ACC-80291) should return verified=true and customer details for Alex Johnson in USD",
      "payload": {
        "message": {
          "type": "tool-calls",
          "toolCalls": [
            {
              "id": "call_alex_001",
              "type": "function",
              "function": {
                "name": "verify_customer",
                "arguments": {
                  "account_id": "ACC-80291",
                  "verification_code": "1234"
                }
              }
            }
          ]
        }
      },
      "expected_output": {
        "verified": true,
        "account_id": "ACC-80291",
        "customer_name": "Alex Johnson",
        "customer_phone": "+1 555-019-9283",
        "outstanding_balance": 1450,
        "currency": "USD"
      }
    },
    {
      "id": "TC-04",
